// This is your Prisma schema file for the extended project management system
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  password            String
  firstName           String              @map("first_name")
  lastName            String              @map("last_name")
  role                UserRole
  areaId              String?             @map("area_id")
  createdBy           String?             @map("created_by")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  // Relaciones existentes
  createdAreas        Area[]              @relation("AreaCreator")
  projectAssignments  ProjectAssignment[] @relation("ProjectAssigner")
  assignedProjects    ProjectAssignment[]
  createdProjects     Project[]           @relation("ProjectCreator")
  createdTasks        Task[]              @relation("TaskCreator")
  approvedTimeEntries TimeEntry[]         @relation("TimeEntryApprover")
  timeEntries         TimeEntry[]
  area                Area?               @relation(fields: [areaId], references: [id])
  creator             User?               @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers        User[]              @relation("UserCreator")
  systemConfigs       SystemConfig[]

  // Nuevas relaciones para staging y transferencias
  stagingArchitect      StagingProject[]    @relation("StagingArchitect")
  stagingDesignManager  StagingProject[]    @relation("StagingDesignManager")
  stagingDesignCoord    StagingProject[]    @relation("StagingDesignCoordinator")
  stagingSalesManager   StagingProject[]    @relation("StagingSalesManager")
  stagingSalesLeader    StagingProject[]    @relation("StagingSalesLeader")
  stagingSalesExecutive StagingProject[]    @relation("StagingSalesExecutive")
  stagingTransfers      StagingProject[]    @relation("StagingTransferrer")
  transfersRequested    AreaTransfer[]      @relation("TransferRequester")
  transfersApproved     AreaTransfer[]      @relation("TransferApprover")
  importLogs            ImportLog[]

  @@map("users")
}

// ============================================
// ÁREAS Y ESTRUCTURA ORGANIZACIONAL
// ============================================

model Area {
  id            String           @id @default(uuid())
  name          String           @unique
  code          String           @unique // DISEÑO, PMO, ATENCION
  description   String?
  color         String           @default("#2563EB")
  orderIndex    Int              @default(0) @map("order_index")
  createdBy     String           @map("created_by")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relaciones
  creator          User             @relation("AreaCreator", fields: [createdBy], references: [id])
  projects         Project[]
  stagingProjects  StagingProject[]
  users            User[]
  transfersFrom    AreaTransfer[]   @relation("TransferFromArea")
  transfersTo      AreaTransfer[]   @relation("TransferToArea")
  workflowsFrom    WorkflowConfig[] @relation("WorkflowFromArea")
  workflowsTo      WorkflowConfig[] @relation("WorkflowToArea")

  @@map("areas")
}

// ============================================
// CLIENTES Y SEGMENTOS
// ============================================

model Client {
  id           String           @id @default(uuid())
  name         String           @unique
  acronym      String           @unique @map("acronym") // Siglas (UAA, STPS, etc.)
  segmentId    String?          @map("segment_id")
  description  String?
  contactInfo  Json?            @map("contact_info") // {email, phone, address}
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relaciones
  segment          Segment?         @relation(fields: [segmentId], references: [id])
  projects         Project[]
  stagingProjects  StagingProject[]

  @@index([acronym])
  @@map("clients")
}

model Segment {
  id           String              @id @default(uuid())
  name         String              @unique // Federal, Estatal, Municipal, Privado
  code         String              @unique // F, E, M, P (para ID interno)
  description  String?
  orderIndex   Int                 @default(0) @map("order_index")
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relaciones
  clients           Client[]
  internalIdConfigs InternalIdConfig[]

  @@map("segments")
}

// ============================================
// PROYECTOS PRINCIPALES
// ============================================

model Project {
  id             String              @id @default(uuid())
  internalId     String              @unique @map("internal_id") // YY-S-XXX-NN
  name           String
  description    String?
  clientId       String              @map("client_id")
  areaId         String              @map("area_id")
  status         ProjectStatus       @default(ACTIVE)
  priority       Priority            @default(MEDIUM)
  startDate      DateTime?           @map("start_date") @db.Date
  endDate        DateTime?           @map("end_date") @db.Date
  estimatedHours Decimal?            @map("estimated_hours") @db.Decimal(8, 2)
  createdBy      String              @map("created_by")
  isGeneral      Boolean             @default(false) @map("is_general")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  // Relaciones
  client             Client               @relation(fields: [clientId], references: [id])
  area               Area                 @relation(fields: [areaId], references: [id])
  creator            User                 @relation("ProjectCreator", fields: [createdBy], references: [id])
  assignments        ProjectAssignment[]
  tasks              Task[]
  timeEntries        TimeEntry[]
  stagingProjects    StagingProject[]
  areaTransfers      AreaTransfer[]

  @@index([internalId])
  @@index([clientId])
  @@map("projects")
}

// ============================================
// PROYECTOS EN STAGING (IMPORTADOS)
// ============================================

model StagingProject {
  id                    String         @id @default(uuid())
  batchId               String         @map("batch_id") // ID del lote de importación
  externalId            String?        @map("external_id") // ID del Excel
  sourceArea            SourceArea     @map("source_area") // DISEÑO o PMO

  // Datos originales del Excel (para trazabilidad)
  rawData               Json           @map("raw_data")

  // === CAMPOS COMUNES MAPEADOS ===
  clientId              String?        @map("client_id")
  projectName           String?        @map("project_name")
  serviceDescription    String?        @db.Text @map("service_description")
  generalStatus         String?        @map("general_status")
  projectStageId        String?        @map("project_stage_id")

  // === CAMPOS ESPECÍFICOS DE DISEÑO ===
  // Personas
  architectId           String?        @map("architect_id")
  designManagerId       String?        @map("design_manager_id")
  designCoordinatorId   String?        @map("design_coordinator_id")
  salesManagerId        String?        @map("sales_manager_id")
  salesLeaderId         String?        @map("sales_leader_id")
  salesExecutiveId      String?        @map("sales_executive_id")

  // Fechas
  requestDate           DateTime?      @map("request_date") @db.Date // Fecha Solicitud (KOM)
  clarificationDate     DateTime?      @map("clarification_date") @db.Date // Fecha JA
  deliveryDate          DateTime?      @map("delivery_date") @db.Date
  decisionDate          DateTime?      @map("decision_date") @db.Date // Fecha Fallo

  // Identificadores
  siebelId              String?        @map("siebel_id")
  opportunityRecord     String?        @map("opportunity_record")

  // Tipos y categorías
  serviceTypeId         String?        @map("service_type_id") // Nuevo/Existente
  contractTypeId        String?        @map("contract_type_id") // Licitación/BAU/Cotización
  businessLineId        String?        @map("business_line_id")

  // Productos y proveedores
  products              String[]       @default([]) // Array de productos
  manufacturers         String[]       @default([]) // Array de fabricantes
  suppliers             String[]       @default([]) // Array de proveedores
  wholesalers           String[]       @default([]) // Array de mayoristas

  // === CAMPOS FINANCIEROS ===
  contractPeriodMonths  Int?           @map("contract_period_months")
  monthlyIncomeMXN      Decimal?       @map("monthly_income_mxn") @db.Decimal(15, 2)
  oneTimeChargeMXN      Decimal?       @map("one_time_charge_mxn") @db.Decimal(15, 2)
  tcvMXN                Decimal?       @map("tcv_mxn") @db.Decimal(15, 2)
  capexTotalMXN         Decimal?       @map("capex_total_mxn") @db.Decimal(15, 2)
  opexTotalMXN          Decimal?       @map("opex_total_mxn") @db.Decimal(15, 2)

  // === RESULTADOS Y COMPETENCIA ===
  winReason             String?        @map("win_reason")
  lossReason            String?        @map("loss_reason")
  winningProvider       String?        @map("winning_provider")
  winningProviderTCV    Decimal?       @map("winning_provider_tcv") @db.Decimal(15, 2)

  // === DOCUMENTACIÓN ===
  sharepointUrl         String?        @map("sharepoint_url")

  // === ESTADO Y VALIDACIÓN ===
  status                StagingStatus  @default(PENDING)
  validationErrors      Json?          @map("validation_errors")
  mappingNotes          String?        @db.Text @map("mapping_notes")

  // === TRANSFERENCIA ===
  transferredToProjectId String?       @map("transferred_to_project_id")
  transferredAt         DateTime?      @map("transferred_at")
  transferredBy         String?        @map("transferred_by")

  // Metadata
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  // === RELACIONES ===
  client                Client?        @relation(fields: [clientId], references: [id])
  projectStage          ProjectStage?  @relation(fields: [projectStageId], references: [id])
  transferredToProject  Project?       @relation(fields: [transferredToProjectId], references: [id])

  // Relaciones con usuarios
  architect             User?          @relation("StagingArchitect", fields: [architectId], references: [id])
  designManager         User?          @relation("StagingDesignManager", fields: [designManagerId], references: [id])
  designCoordinator     User?          @relation("StagingDesignCoordinator", fields: [designCoordinatorId], references: [id])
  salesManager          User?          @relation("StagingSalesManager", fields: [salesManagerId], references: [id])
  salesLeader           User?          @relation("StagingSalesLeader", fields: [salesLeaderId], references: [id])
  salesExecutive        User?          @relation("StagingSalesExecutive", fields: [salesExecutiveId], references: [id])
  transferredByUser     User?          @relation("StagingTransferrer", fields: [transferredBy], references: [id])

  // Relaciones con catálogos
  serviceType           Catalog?       @relation("ServiceTypeCatalog", fields: [serviceTypeId], references: [id])
  contractType          Catalog?       @relation("ContractTypeCatalog", fields: [contractTypeId], references: [id])
  businessLine          Catalog?       @relation("BusinessLineCatalog", fields: [businessLineId], references: [id])

  // Relación con área
  area                  Area?          @relation(fields: [sourceArea], references: [code])

  @@index([batchId])
  @@index([sourceArea])
  @@index([status])
  @@index([clientId])
  @@map("staging_projects")
}

// ============================================
// ETAPAS Y ESTADOS DE PROYECTO
// ============================================

model ProjectStage {
  id          String           @id @default(uuid())
  code        String           @unique // PROPUESTA, ADJUDICADO, ENTREGADO, etc.
  name        String
  description String?
  color       String           @default("#6B7280")
  orderIndex  Int              @default(0) @map("order_index")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relaciones
  stagingProjects StagingProject[]
  statusMappings  StatusMapping[]

  @@map("project_stages")
}

// ============================================
// SISTEMA DE MAPEO CONFIGURABLE
// ============================================

model FieldMapping {
  id              String      @id @default(uuid())
  sourceArea      SourceArea  @map("source_area")
  sourceField     String      @map("source_field") // Nombre del campo en Excel
  targetField     String      @map("target_field") // Nombre del campo en BD
  targetTable     String      @map("target_table") // staging_projects, projects, etc.
  transformation  String?     // UPPERCASE, DATE_FORMAT, USER_LOOKUP, etc.
  defaultValue    String?     @map("default_value")
  isRequired      Boolean     @default(false) @map("is_required")
  validationRule  String?     @map("validation_rule") // Regex o función
  description     String?
  orderIndex      Int         @default(0) @map("order_index")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([sourceArea, sourceField, targetTable])
  @@index([sourceArea, isActive])
  @@map("field_mappings")
}

model StatusMapping {
  id              String        @id @default(uuid())
  sourceArea      SourceArea    @map("source_area")
  sourceStatus    String        @map("source_status") // Estado en Excel
  projectStageId  String        @map("project_stage_id")
  projectStatus   ProjectStatus @map("project_status")
  description     String?
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  projectStage    ProjectStage  @relation(fields: [projectStageId], references: [id])

  @@unique([sourceArea, sourceStatus])
  @@map("status_mappings")
}

// ============================================
// CATÁLOGOS UNIFICADOS
// ============================================

model Catalog {
  id          String      @id @default(uuid())
  type        CatalogType
  code        String      // Código único dentro del tipo
  name        String
  description String?
  metadata    Json?       // Datos adicionales específicos del tipo
  orderIndex  Int         @default(0) @map("order_index")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relaciones con staging projects
  stagingServiceType   StagingProject[] @relation("ServiceTypeCatalog")
  stagingContractType  StagingProject[] @relation("ContractTypeCatalog")
  stagingBusinessLine  StagingProject[] @relation("BusinessLineCatalog")

  @@unique([type, code])
  @@index([type, isActive])
  @@map("catalogs")
}

// ============================================
// FLUJO DE TRANSFERENCIAS
// ============================================

model AreaTransfer {
  id              String         @id @default(uuid())
  projectId       String         @map("project_id")
  fromAreaId      String         @map("from_area_id")
  toAreaId        String         @map("to_area_id")
  transferType    TransferType   @map("transfer_type")
  transferDate    DateTime       @default(now()) @map("transfer_date")
  transferReason  String?        @map("transfer_reason")
  transferNotes   String?        @db.Text @map("transfer_notes")
  requestedBy     String         @map("requested_by")
  approvedBy      String?        @map("approved_by")
  approvedAt      DateTime?      @map("approved_at")
  status          TransferStatus @default(PENDING)
  completedAt     DateTime?      @map("completed_at")

  // Datos snapshot al momento de transferencia
  dataSnapshot    Json?          @map("data_snapshot")

  // Validaciones aplicadas
  validationResults Json?        @map("validation_results")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relaciones
  project         Project        @relation(fields: [projectId], references: [id])
  fromArea        Area           @relation("TransferFromArea", fields: [fromAreaId], references: [id])
  toArea          Area           @relation("TransferToArea", fields: [toAreaId], references: [id])
  requester       User           @relation("TransferRequester", fields: [requestedBy], references: [id])
  approver        User?          @relation("TransferApprover", fields: [approvedBy], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([fromAreaId, toAreaId])
  @@map("area_transfers")
}

// ============================================
// CONFIGURACIÓN DEL SISTEMA
// ============================================

model InternalIdConfig {
  id              String   @id @default(uuid())
  segmentId       String   @map("segment_id")
  year            Int
  lastSequence    Int      @default(0) @map("last_sequence")
  prefix          String?  // Prefijo adicional opcional
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  segment         Segment  @relation(fields: [segmentId], references: [id])

  @@unique([segmentId, year])
  @@map("internal_id_configs")
}

model WorkflowConfig {
  id              String   @id @default(uuid())
  name            String   @unique
  fromAreaId      String   @map("from_area_id")
  toAreaId        String   @map("to_area_id")
  requiredFields  String[] @map("required_fields") // Campos requeridos para transferencia
  validations     Json?    // Reglas de validación personalizadas
  autoApprove     Boolean  @default(false) @map("auto_approve")
  notifyRoles     String[] @map("notify_roles") // Roles a notificar
  allowedRoles    String[] @map("allowed_roles") // Roles que pueden ejecutar
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fromArea        Area     @relation("WorkflowFromArea", fields: [fromAreaId], references: [id])
  toArea          Area     @relation("WorkflowToArea", fields: [toAreaId], references: [id])

  @@unique([fromAreaId, toAreaId])
  @@map("workflow_configs")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator     User     @relation(fields: [createdBy], references: [id])

  @@map("system_configs")
}

// ============================================
// LOGS Y AUDITORÍA
// ============================================

model ImportLog {
  id              String    @id @default(uuid())
  batchId         String    @map("batch_id")
  fileName        String    @map("file_name")
  sourceArea      SourceArea @map("source_area")
  totalRecords    Int       @map("total_records")
  processedRecords Int      @map("processed_records")
  successRecords  Int       @map("success_records")
  errorRecords    Int       @map("error_records")
  skippedRecords  Int       @map("skipped_records")
  errors          Json?     // Detalle de errores
  summary         Json?     // Resumen de la importación
  importedBy      String    @map("imported_by")
  startedAt       DateTime  @map("started_at")
  completedAt     DateTime? @map("completed_at")

  importer        User      @relation(fields: [importedBy], references: [id])

  @@index([batchId])
  @@index([sourceArea])
  @@map("import_logs")
}

// ============================================
// MODELOS EXISTENTES (COMPATIBILIDAD)
// ============================================

model ProjectAssignment {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  userId       String   @map("user_id")
  assignedById String   @map("assigned_by")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  isActive     Boolean  @default(true) @map("is_active")

  assignedBy   User     @relation("ProjectAssigner", fields: [assignedById], references: [id])
  project      Project  @relation(fields: [projectId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId, isActive])
  @@map("project_assignments")
}

model Task {
  id             String      @id @default(uuid())
  title          String
  description    String?
  projectId      String      @map("project_id")
  status         TaskStatus  @default(TODO)
  priority       Priority    @default(MEDIUM)
  estimatedHours Decimal?    @map("estimated_hours") @db.Decimal(8, 2)
  createdBy      String?     @map("created_by")
  dueDate        DateTime?   @map("due_date") @db.Date
  tags           String[]    @default([])
  order          Int?        @default(0)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  creator        User?       @relation("TaskCreator", fields: [createdBy], references: [id])
  project        Project     @relation(fields: [projectId], references: [id])
  timeEntries    TimeEntry[]

  @@map("tasks")
}

model TimePeriod {
  id             String      @id @default(uuid())
  year           Int
  month          Int
  periodNumber   Int         @map("period_number")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  referenceHours Decimal?    @map("reference_hours") @db.Decimal(5, 2)
  type           String?     @default("weekly")
  description    String?
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @default(now()) @map("updated_at")

  timeEntries    TimeEntry[]

  @@unique([year, month, periodNumber])
  @@map("time_periods")
}

model TimeEntry {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  projectId    String     @map("project_id")
  taskId       String?    @map("task_id")
  timePeriodId String     @map("time_period_id")
  date         DateTime   @db.Date
  hours        Decimal    @db.Decimal(4, 2)
  description  String?
  isApproved   Boolean    @default(false) @map("is_approved")
  approvedBy   String?    @map("approved_by")
  approvedAt   DateTime?  @map("approved_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  approver     User?      @relation("TimeEntryApprover", fields: [approvedBy], references: [id])
  project      Project    @relation(fields: [projectId], references: [id])
  task         Task?      @relation(fields: [taskId], references: [id])
  timePeriod   TimePeriod @relation(fields: [timePeriodId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, projectId, taskId, date])
  @@map("time_entries")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMINISTRADOR
  COORDINADOR
  COLABORADOR
  VISOR
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  AWARDED     // Adjudicado
  LOST        // Perdido
  IN_PROPOSAL // En propuesta
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum SourceArea {
  DISENO @map("DISEÑO")
  PMO
}

enum StagingStatus {
  PENDING     // Pendiente de validación
  VALIDATED   // Validado, listo para transferir
  TRANSFERRED // Transferido a proyecto
  ERROR       // Con errores de validación
  REJECTED    // Rechazado manualmente
}

enum TransferType {
  DESIGN_TO_PMO           // Diseño → PMO
  PMO_TO_CUSTOMER_SERVICE // PMO → Atención a Clientes
  RETURN_TO_DESIGN        // Regreso a Diseño para correcciones
  CUSTOM                  // Transferencia personalizada
}

enum TransferStatus {
  PENDING   // Pendiente de aprobación
  APPROVED  // Aprobada, esperando ejecución
  COMPLETED // Completada
  REJECTED  // Rechazada
  CANCELLED // Cancelada
}

enum CatalogType {
  SERVICE_TYPE     @map("service_type")     // Nuevo/Existente
  CONTRACT_TYPE    @map("contract_type")    // Licitación/BAU/Cotización
  BUSINESS_LINE    @map("business_line")    // Línea de negocio
  PRODUCT         @map("product")           // Productos
  MANUFACTURER    @map("manufacturer")      // Fabricantes
  SUPPLIER        @map("supplier")          // Proveedores
  WHOLESALER      @map("wholesaler")        // Mayoristas
}